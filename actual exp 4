h1 {
   color: blue;
   text-align: center;
}

table {
   border: 2px solid black;
   border-collapse: collapse;
}

th, td {
   border: 1px solid black;
   padding: 10px;
}

.highlight {
   color: red;
   font-weight: bold;
}
